-- 1. Test polling place locator with voter info
SELECT 
    v.FirstName,
    v.LastName,
    v.Address AS "Voter Address",
    p.PlaceName AS "Polling Place",
    p.Address AS "Polling Place Address",
    p.Hours
FROM Voters v
JOIN PollingPlaces p ON v.PollingPlaceID = p.PollingPlaceID
WHERE v.ZipCode = '12345';

-- 2. Modify a table (add accessibility features)
ALTER TABLE PollingPlaces
ADD AccessibilityFeatures VARCHAR(100);

UPDATE PollingPlaces
SET AccessibilityFeatures = 'Wheelchair ramp, Handicap parking'
WHERE PollingPlaceID = 1;

-- 3. Prove table modification
SELECT * FROM PollingPlaces
WHERE PollingPlaceID = 1;

-- 4. Delete a polling place (must handle foreign key constraint)
-- First update voters assigned to this polling place
UPDATE Voters
SET PollingPlaceID = 1
WHERE PollingPlaceID = 2;

-- Then delete the polling place
DELETE FROM PollingPlaces
WHERE PollingPlaceID = 2;

-- 5. Prove deletion
SELECT * FROM PollingPlaces;

