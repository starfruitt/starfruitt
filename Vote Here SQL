-- Create and populate tables
CREATE TABLE PollingPlaces (
    PollingPlaceID INT PRIMARY KEY,
    PlaceName VARCHAR(100),
    Address VARCHAR(100),
    ZipCode VARCHAR(10),
    Hours VARCHAR(50)
);

CREATE TABLE Voters (
    VoterID INT PRIMARY KEY,
    FirstName VARCHAR(50),
    LastName VARCHAR(50),
    Address VARCHAR(100),
    ZipCode VARCHAR(10),
    PollingPlaceID INT,
    FOREIGN KEY (PollingPlaceID) REFERENCES PollingPlaces(PollingPlaceID)
);

